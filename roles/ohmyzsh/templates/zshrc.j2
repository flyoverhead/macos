# {{ ansible_managed }}

# Enable Powerlevel10k instant prompt
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Custom $PATH with extra locations.
export PATH={{ ohmyzsh_venv_path }}/bin:{{ ohmyzsh_homebrew_bin_path }}:/usr/local/bin:/usr/local/sbin:$HOME/bin:$PATH

# Export oh-my-zsh installation path.
export ZSH="$HOME/.oh-my-zsh"

# Colors.
unset LSCOLORS
export CLICOLOR=1
export CLICOLOR_FORCE=1

# Allow multithreading applications/scripts under the new macOS security rules.
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Add GPG password prompt.
export GPG_TTY=$TTY
{% if ohmyzsh_vault_addr | length > 0 %}

# Vault address.
export VAULT_ADDR={{ ohmyzsh_vault_addr }}
{% endif %}
{% if ohmyzsh_exports | length > 0 %}

# Extra exports.
{% for name, value in ohmyzsh_exports | dictsort %}
export {{ name }}={{ value }}
{% endfor %}
{% endif %}

# Don't require escaping globbing characters in zsh.
unsetopt nomatch

# SSH-agent configuration.
zstyle :omz:plugins:ssh-agent quiet yes
zstyle :omz:plugins:ssh-agent agent-forwarding yes
zstyle :omz:plugins:ssh-agent identities {{ ohmyzsh_ssh_key_file }}
zstyle :omz:plugins:ssh-agent ssh-add-args {{ ohmyzsh_ssh_add_args }}

# Homebrew share directory, where the theme and the extra plugins live.
share_path="{{ ohmyzsh_homebrew_share_path }}"

# Completions.
{% if 'zsh-autocomplete' in (ohmyzsh_install_plugins | map(attribute='name') | list) %}
fpath=(${share_path}/zsh-autocomplete/Completions $fpath)
{% endif %}
{% for path in ohmyzsh_extra_fpath %}
fpath=({{ path }} $fpath)
{% endfor %}
# Case insensitive.
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*'

# Enable zsh auto-update.
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 3

# Enable plugins.
plugins=({{ ohmyzsh_plugins | join(' ') }})

# Source oh-my-zsh.
source $ZSH/oh-my-zsh.sh

# Enable powerlevel10k theme.
source ${share_path}/{{ ohmyzsh_theme_package }}/{{ ohmyzsh_theme_package }}.zsh-theme
{% if ohmyzsh_install_plugins | length > 0 %}

# Enable extra plugins.
{% for plugin in ohmyzsh_install_plugins %}
[ -f ${share_path}/{{ plugin.name }}/{{ plugin.source }} ] && source ${share_path}/{{ plugin.name }}/{{ plugin.source }}
{% endfor %}
{% endif %}
{% if ohmyzsh_history_substring_bindkeys and 'zsh-history-substring-search' in (ohmyzsh_install_plugins | map(attribute='name') | list) %}

# Allow history search via up/down keys.
bindkey "^[[A" history-substring-search-up
bindkey "^[[B" history-substring-search-down
{% endif %}

# Include alias file (if present) containing aliases for ssh, etc.
if [ -f ~/.aliases ]; then
  source ~/.aliases
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Source fzf.
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
{% if ohmyzsh_task_completion %}

# go-task completions, if go-task is installed.
command -v task >/dev/null 2>&1 && eval "$(task --completion zsh)"
{% endif %}
{% if ohmyzsh_kubectl_completion %}

command -v kubectl >/dev/null 2>&1 && source <(kubectl completion zsh)
{% endif %}

# Function for deleting a given line number in the known_hosts file.
knownrm() {
  re='^[0-9]+$'
  if ! [[ $1 =~ $re ]]; then
    echo "error: line number missing" >&2
  else
    sed -i '' "$1d" ~/.ssh/known_hosts
  fi
}

function b64e() {
  echo -n "${1}" | base64
}

function b64d() {
  echo -n "${1}" | base64 --decode
}
{% if ohmyzsh_vault_addr | length > 0 %}

# Log in to Vault via OIDC and export the resulting token.
function vault-login() {
  vault login -method=oidc role=${1:-user} && \
  if [ -f ~/.vault-token ]; then
    token=$(cat ~/.vault-token)
    if [ ! -z $token ]; then
      export VAULT_TOKEN=$token
    fi
    rm ~/.vault-token
  fi
}
{% endif %}
{% if ohmyzsh_ci_registry | length > 0 and ohmyzsh_ci_images | length > 0 %}

# Run a CI image over the current working directory.
function ci-run() {
{% if ohmyzsh_vault_addr | length > 0 %}
  vault token lookup >/dev/null 2>&1 || vault-login "${2}"
{% endif %}
  docker_registry={{ ohmyzsh_ci_registry }}
  case "${1}" in
{% for alias, image in ohmyzsh_ci_images | dictsort %}
    "{{ alias }}")
      docker_image='{{ image }}'
    ;;
{% endfor %}
    --)
      echo "You must supply a container ID or name."
      return 1
    ;;
    *)
      docker_image="${1}"
    ;;
  esac
  docker run --network host \
    -e VAULT_ADDR=${VAULT_ADDR} \
    -e USER_VAULT_TOKEN=${VAULT_TOKEN} \
    -e GL_USER_TOKEN=${GL_USER_TOKEN:-} \
    -e TF_STATE_NAME=${TF_STATE_NAME:-} \
    --rm -it \
    --volume "$PWD:/ci:rw" \
    --volume "${HOME}/.ssh/ansible:/home/ansible/ssh_key" \
    --volume "${HOME}/.docker/.env:/ci/.env:ro" \
    --workdir "/ci" \
    ${docker_registry}/${docker_image} /bin/bash --init-file .env
}
{% endif %}
